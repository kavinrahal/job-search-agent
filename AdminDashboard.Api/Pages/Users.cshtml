@page
@model AdminDashboard.Api.Pages.UsersModel
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<form method="get" class="card" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
    <div class="field" style="flex:1; min-width:200px; margin-bottom:0;">
        <label for="Search">Search by email</label>
        <input type="search" id="Search" name="Search" value="@Model.Search" placeholder="jane@example.com" />
    </div>
    <div class="field" style="min-width:160px; margin-bottom:0;">
        <label for="Tier">Tier</label>
        <select id="Tier" name="Tier">
            <option value="">All tiers</option>
            <option value="Tier1" selected="@(Model.Tier == "Tier1")">Tier 1</option>
            <option value="Tier2" selected="@(Model.Tier == "Tier2")">Tier 2</option>
        </select>
    </div>
    <button type="submit">Filter</button>
</form>

<div class="card" style="margin-top:16px;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Tier</th>
                    <th class="num">Credit balance</th>
                    <th>Verified</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Tier == UserTier.Tier2)
                            {
                                <span class="badge badge-tier2">Tier 2</span>
                            }
                            else
                            {
                                <span class="badge">Tier 1</span>
                            }
                        </td>
                        <td class="num">@u.CreditBalance</td>
                        <td>
                            @if (u.EmailVerifiedAt is not null)
                            {
                                <span class="badge badge-ok">Verified</span>
                            }
                            else
                            {
                                <span class="badge badge-warn">Unverified</span>
                            }
                        </td>
                        <td class="mono">@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                @if (Model.Users.Count == 0)
                {
                    <tr><td colspan="5">No users match.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
