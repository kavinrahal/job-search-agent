server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Security headers — carried over from when the API served this SPA directly.
    # connect-src includes the API's own origin now that calls to it are cross-origin.
    # Reuses VITE_API_URL (already needed at build time for the JS bundle) rather than a
    # second identically-valued variable — Railway injects declared service variables into
    # the running container too, not just as build args, so it's available here at startup.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ${VITE_API_URL} https://accounts.google.com; font-src 'self'; frame-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com" always;

    # nginx's stock mime.types has no entry for .mjs, so it was falling back to
    # application/octet-stream — combined with X-Content-Type-Options: nosniff above, browsers
    # refuse to execute it as a script. pdfjs-dist ships its worker as .mjs (react-pdf/pdf.js),
    # so without this the PDF viewer's worker setup fails to load entirely.
    location ~* \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    # Vite fingerprints every built asset filename with a content hash (e.g.
    # assets/index-cuIxGJqA.js) — a byte changes, the filename changes. Nothing ever needed to
    # invalidate one of these URLs, so it's safe to tell browsers to never revalidate it.
    # Without this there was no Cache-Control on anything at all, so a build baked with a stale
    # VITE_API_URL (or any other pre-deploy state) could keep being served from a browser's own
    # heuristic cache long after a newer, correct build had shipped.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Client-side routing (react-router) — unknown paths fall back to index.html. index.html
    # itself is the one file that's never safe to let a browser cache on its own judgment: it's
    # what points at the current asset hashes above, so a stale copy of just this one file is
    # what let an old build (and its old baked-in VITE_API_URL) keep being served indefinitely.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
